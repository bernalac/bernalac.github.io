---
interface Props {
  href: string;
  title: string;
  subtitle: string;
  external?: boolean;
}

const {
  href,
  title,
  subtitle,
  external = false,
} = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class="group flex min-h-[76px] items-center gap-4 border-b border-border px-1 py-4 transition-colors duration-200 hover:border-accent/50"
>
  <span
    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-burgundy-950/5 text-primary transition-colors duration-200 group-hover:bg-burgundy-950 group-hover:text-cream-50"
  >
    <slot name="icon" />
  </span>

  <span class="min-w-0 flex-1">
    <span
      class="block text-base font-medium text-content transition-colors duration-200 group-hover:text-accent"
    >
      {title}
    </span>

    <span
      class="mt-0.5 block truncate text-sm text-content-muted"
    >
      {subtitle}
    </span>
  </span>

  <span
    aria-hidden="true"
    class="shrink-0 text-lg text-content-muted transition-all duration-200 group-hover:translate-x-1 group-hover:text-accent"
  >
    →
  </span>
</a>
