---
import SectionHeader from "./SectionHeader.astro";
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../../../data/projects";
---

<section aria-label="Proyectos" class="py-12">
  <SectionHeader title="Proyectos" />

  <ul class="mt-6 grid gap-4 sm:grid-cols-2" role="list">

    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}

    <li class="flex items-center justify-center rounded-lg border border-dashed border-zinc-700/50 p-5">
      <a
        href="https://github.com/bernalac"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-zinc-400 hover:text-zinc-300 transition-colors"
      >
        Ver más en GitHub →
      </a>
    </li>

  </ul>
</section>