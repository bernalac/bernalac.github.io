---
interface Props {
  role: string;
  company: string;
  period: string;
  description: string;
  highlight?: string;
  current?: boolean;
}

const { role, company, period, description, highlight, current } = Astro.props;
---

<article class="group rounded-lg border border-transparent p-4 -mx-4 transition-all duration-300 hover:border-zinc-700/60 hover:bg-zinc-800/40">
  <div class="flex items-start justify-between gap-4">

    <div>
      <div class="flex items-center gap-2">
        <p class="text-sm font-medium text-zinc-100">{role}</p>
      </div>
      <p class="text-sm text-zinc-300 mt-1">{company}</p>
    </div>

    <span class="shrink-0 font-mono text-xs text-zinc-400 transition-colors group-hover:text-zinc-300">
      {period}
    </span>
  </div>

  <p class="mt-3 text-sm leading-relaxed text-zinc-400 transition-colors group-hover:text-zinc-200">
    {description}
  </p>

  {highlight && (
    <p class="mt-2 text-xs text-cyan-400/80">
      ↗ {highlight}
    </p>
  )}
</article>