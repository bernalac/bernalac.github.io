---
import SectionHeader from "./SectionHeader.astro";
import SkillBadge from "./SkillBadge.astro";
import { skills } from "../../../data/skills";

const categories = [...new Set(skills.map((s) => s.category))]; 
---

<section aria-label="Tecnologías" class="py-12">
  <SectionHeader title="Tecnologías" />

  <div class="space-y-6">
    {categories.map((category) => (
      <div>
        <p class="mb-3 text-xs text-zinc-300 uppercase tracking-widest">
          {category}
        </p>
        <div
          class="flex flex-wrap gap-2"
          role="list"
          aria-label={`Tecnologías de ${category}`}
        >
          {skills
            .filter((s) => s.category === category)
            .map((skill) => (
              <div role="listitem">
                <SkillBadge name={skill.name} level={skill.level} />
              </div>
            ))}
        </div>
      </div>
    ))}
  </div>

</section>