---
const stats = [
  { value: "5+",  label: "años",                        title: "Experiencia" },
  { value: "3",   label: "empresas del sector público",  title: "Sector"      },
  { value: "20+", label: "tecnologías",                  title: "Stack"       },
];
---

<section aria-label="Resumen" class="py-10">
  <dl class="grid grid-cols-3 gap-4">
    {stats.map(({ value, label, title }) => (
      <div class="rounded-lg bg-zinc-800/50 border border-zinc-700/50 px-4 py-4">
        <dt class="text-xs text-zinc-500 mb-1">{title}</dt>
        <dd class="text-2xl font-medium text-zinc-100">{value}</dd>
        <dd class="text-xs text-zinc-500 mt-0.5">{label}</dd>
      </div>
    ))}
  </dl>
</section>