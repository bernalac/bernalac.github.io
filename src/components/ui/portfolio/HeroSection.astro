---
import Button from "../generics/Button.astro";
import ButtonLink from "../generics/ButtonLink.astro";

const technologies = [
  "Java",
  "Spring Boot",
  "Angular",
  "CI/CD",
  "IA aplicada",
];
---

<section aria-label="Presentación" class="py-20">

  <div class="flex items-center gap-4 mb-6">
    <div>
      <h1 class="text-5xl font-medium text-zinc-100 leading-tight tracking-tight">
        Javier Bernal
      </h1>
      <p class="mt-0.5 text-lg text-zinc-300 tracking-wide">
        Desarrollador Full Stack
      </p>
    </div>
  </div>

  <p class="text-zinc-300 leading-relaxed">
    Desarrollador full stack con más de cinco años de experiencia 
    creando aplicaciones para la administración pública con Spring Boot y Angular. 
    Interesado en aplicar IA al desarrollo de software, la automatización y la mejora continua dentro de equipos ágiles.
  </p>

  <div class="mt-4 flex flex-wrap gap-2">
    {technologies.map((tag) => (
      <span class="rounded-full border border-zinc-700 bg-zinc-800/50 px-3 py-0.5 text-xs text-zinc-300 cursor-default transition-all duration-300 hover:border-cyan-400/50 hover:bg-cyan-400/10 hover:text-cyan-300 hover:shadow-[0_0_10px_rgba(34,211,238,0.15)] hover:-translate-y-px">
        {tag}
      </span>
    ))}
  </div>

  <div class="mt-8 flex items-center gap-3">
    <Button href="/contact">Contacto</Button>
    <ButtonLink href="/blog">Leer artículos →</ButtonLink>
  </div>

</section>