---
import Button from "../generics/Button.astro";
import ButtonLink from "../generics/ButtonLink.astro";
import { Image } from "astro:assets";
import avatar from "../../../assets/avatar.webp";
---

<section aria-label="Presentación" class="py-20">

  <div class="flex items-center gap-4 mb-6">
    <div class="relative h-24 w-24 shrink-0 group">
      <Image src={avatar} alt="Foto de Javier Bernal, desarrollador full stack" width={96} height={96} class="h-full w-full rounded-full object-cover border border-zinc-700
              transition-all duration-300 ease-out
              group-hover:scale-110 group-hover:brightness-110 transform-gpu
              group-hover:shadow-md group-hover:shadow-cyan-500/30" />
      <div
        style="display:none"
        class="absolute inset-0 rounded-full bg-cyan-400/10 border border-cyan-400/20 flex items-center justify-center text-cyan-400 font-medium text-lg select-none"
        aria-hidden="true"
      >
        JB
      </div>
    </div>
    <div>
      <h1 class="text-4xl font-medium text-zinc-100 leading-tight tracking-tight">
        Javier Bernal
      </h1>
      <p class="mt-0.5 text-lg text-zinc-300 tracking-wide">
        Desarrollador Full Stack
      </p>
    </div>
  </div>

  <p class="text-zinc-300 leading-relaxed">
    Más de 5 años construyendo aplicaciones para la administración pública con
    <strong class="text-zinc-200 font-medium">Spring Boot</strong> y
    <strong class="text-zinc-200 font-medium">Angular</strong>.
    Apasionado por la <strong class="text-zinc-200 font-medium">IA aplicada</strong>
    al flujo de desarrollo y los entornos ágiles con equipos multidisciplinares.
  </p>

  <div class="mt-4 flex flex-wrap gap-2">
    {["Java", "Spring Boot", "Angular", "CI/CD", "IA aplicada"].map((tag) => (
      <span class="rounded-full border border-zinc-700 bg-zinc-800/50 px-3 py-0.5 text-xs text-zinc-300 cursor-default transition-all duration-300 hover:border-cyan-400/50 hover:bg-cyan-400/10 hover:text-cyan-300 hover:shadow-[0_0_10px_rgba(34,211,238,0.15)] hover:-translate-y-px">
        {tag}
      </span>
    ))}
  </div>

  <div class="mt-8 flex items-center gap-3">
    <Button href="/contact">Contacto</Button>
    <ButtonLink href="/blog">Ver contenido técnico →</ButtonLink>
  </div>

</section>