---
import SectionHeader from "./SectionHeader.astro";
import ExperienceItem from "./ExperienceItem.astro";
import { experience } from "../../../data/experience";
---

<section aria-label="Experiencia" class="py-12">
  <SectionHeader title="Experiencia" />

  <ol class="relative mt-8 space-y-8 border-l border-zinc-800">
    {experience.map((item) => (
      <li class="ml-6">
        <span
          class={`absolute -left-1.5 h-3 w-3 rounded-full border-2 border-zinc-900 ${
            item.current ? "bg-cyan-400" : "bg-zinc-600"
          }`}
        />
        <ExperienceItem {...item} />
      </li>
    ))}
  </ol>
</section>