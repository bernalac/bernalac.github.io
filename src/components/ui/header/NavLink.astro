---
interface Props {
  href: string;
  active?: boolean;
}

const { href, active = false } = Astro.props;
---

<a
  href={href}
  aria-current={active ? "page" : undefined}
  class:list={[
    "relative px-3 py-2 text-base tracking-[-0.01em] transition-colors duration-200",
    active
      ? "font-medium text-primary"
      : "text-content-muted hover:text-content",
  ]}
>
  <slot />

  {
    active && (
      <span
        class="absolute inset-x-3 -bottom-0.5 h-px bg-accent"
        aria-hidden="true"
      />
    )
  }
</a>
