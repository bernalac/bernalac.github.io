---
import NavLink from "../components/ui/header/NavLink.astro";

const pathname = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/blog", label: "Artículos" },
  { href: "/contact", label: "Contacto" },
];

const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-border/80 bg-surface/95 backdrop-blur-sm"
>
  <div
    class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4 sm:px-6"
  >
    <!-- Marca personal -->
    <a
      href="/"
      aria-label="bernalac · Inicio"
      class="group text-lg font-semibold tracking-[-0.02em] text-primary transition-colors duration-300 hover:text-accent"
    >
      @bernalac
    </a>

    <!-- Navegación escritorio -->
    <nav aria-label="Principal" class="hidden items-center gap-1 md:flex">
      {
        navItems.map((item) => (
          <NavLink href={item.href} active={isActive(item.href)}>
            {item.label}
          </NavLink>
        ))
      }
    </nav>
  </div>

  <!-- Navegación móvil -->
  <nav
    aria-label="Navegación principal"
    class="border-t border-border/70 md:hidden"
  >
    <div class="mx-auto flex max-w-4xl items-center justify-around px-4 py-2">
      {
        navItems.map((item) => (
          <NavLink href={item.href} active={isActive(item.href)}>
            {item.label}
          </NavLink>
        ))
      }
    </div>
  </nav>
</header>
