---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/ui/portfolio/HeroSection.astro";
import StatsSection from "../components/ui/portfolio/StatsSection.astro";
import ProjectsSection from "../components/ui/portfolio/ProjectsSection.astro";
import ExperienceSection from "../components/ui/portfolio/ExperienceSection.astro";
import SkillsSection from "../components/ui/portfolio/SkillsSection.astro";
---

<BaseLayout title="Portfolio - bernalac" description="Soy un desarrollador web full stack con experiencia en la creación de aplicaciones modernas y escalables. Explora mis proyectos, experiencia laboral, mi blog y habilidades técnicas para conocer más sobre mi trayectoria profesional.">

  <HeroSection />

  <hr class="border-zinc-700" aria-hidden="true" />

  <StatsSection />

  <hr class="border-zinc-700" aria-hidden="true" />

  <ProjectsSection />

  <hr class="border-zinc-700" aria-hidden="true" />

  <ExperienceSection />

  <hr class="border-zinc-700" aria-hidden="true" />

  <SkillsSection />

</BaseLayout>