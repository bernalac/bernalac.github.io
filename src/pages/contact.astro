---
import ContactCard from "../components/ui/contact/ContactCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contacto - bernalac"
  description="Ponte en contacto conmigo para hablar sobre proyectos, colaboraciones o simplemente para saludar."
>
  <section>
    <header>
      <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">
        Contacto
      </p>

      <h1
        class="mt-5 text-4xl font-semibold tracking-[-0.035em] text-primary sm:text-5xl"
      >
        Hablemos
      </h1>

      <p
        class="mt-5 max-w-xl text-base leading-7 text-content-muted sm:text-lg"
      >
        Si quieres hablar sobre un proyecto, colaborar o simplemente saludar, aquí tienes las mejores formas de encontrarme.
      </p>
    </header>

    <div class="mt-12 flex flex-col gap-3">
      <ContactCard
        href="mailto:franjaberra@gmail.com"
        title="Email"
        subtitle="franjaberra@gmail.com"
      >
        <svg
          slot="icon"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 2v.5l-8 5.5-8-5.5V6h16zm-16 12V8.9l7.43 5.11a1 1 0 0 0 1.14 0L20 8.9V18H4z"
          />
        </svg>
      </ContactCard>

      <ContactCard
        href="https://github.com/bernalac"
        title="GitHub"
        subtitle="@bernalac"
        external
      >
        <svg
          slot="icon"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 .5C5.7.5.8 5.4.8 11.8c0 5 3.2 9.3 7.7 10.8.6.1.8-.2.8-.6v-2.1c-3.1.7-3.8-1.3-3.8-1.3-.5-1.2-1.2-1.5-1.2-1.5-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 .1.8 2.1 2.6 2.7.1-.7.4-1.2.7-1.5-2.5-.3-5.1-1.3-5.1-5.8 0-1.3.5-2.4 1.2-3.3-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2.9-.2 1.9-.3 2.9-.3s2 .1 2.9.3c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.7.9.8 1 .8 2v2.9c0 .3.2.7.8.6 4.5-1.5 7.7-5.8 7.7-10.8C23.2 5.4 18.3.5 12 .5z"
          />
        </svg>
      </ContactCard>

      <ContactCard
        href="https://linkedin.com/in/francisco-javier-bernal"
        title="LinkedIn"
        subtitle="francisco-javier-bernal"
        external
      >
        <svg
          slot="icon"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M20.4 20.4h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6h.1c.5-1 1.8-2 3.7-2 3.9 0 4.6 2.5 4.6 5.7v6.1zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM3.5 20.4h3.6V9H3.5v11.4z"
          />
        </svg>
      </ContactCard>
    </div>
  </section>
</BaseLayout>
