---
import Button from "../../components/ui/generics/Button.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Blog - bernalac" description="Explora mi blog personal donde comparto artículos sobre desarrollo web, backend con Java y Spring Boot, arquitectura de software y experiencias personales aprendidas durante mi carrera como desarrollador full stack.">
  <section class="mx-auto w-full max-w-2xl px-4 py-16">

    <span class="mb-4 rounded-full border border-zinc-700 bg-zinc-800 px-3 py-1 text-sm text-zinc-300">
      🚧 Próximamente
    </span>

    <h1 class="text-3xl font-bold tracking-tight text-zinc-100 sm:text-3xl mt-6">
      Blog en construcción
    </h1>

    <p class="mt-6 leading-relaxed text-zinc-300">
      Estoy preparando artículos sobre desarrollo web, backend con Java y Spring Boot,
      arquitectura de software y algunas experiencias personales aprendidas durante mi carrera.
    </p>

    <div class="mt-6">
      <Button href="/">
        Volver al inicio
      </Button>
    </div>

  </section>
</BaseLayout>