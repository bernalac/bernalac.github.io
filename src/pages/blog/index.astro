---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Blog - bernalac"
  description="Artículos sobre desarrollo web, Java, Spring Boot, arquitectura de software y experiencias aprendidas durante mi carrera como desarrollador full stack."
>
  <section class="mx-auto w-full max-w-2xl px-4 py-16">

    <h1 class="text-3xl font-medium leading-tight text-zinc-100">
      Artículos
    </h1>

    {sortedPosts.length > 0 && (
      <p class="mt-3 text-zinc-300 leading-relaxed">
        {sortedPosts.length} {sortedPosts.length === 1 ? "entrada" : "entradas"}
      </p>
    )}

    {sortedPosts.length === 0 ? (
      <p class="mt-10 text-zinc-300">
        Todavía no hay artículos publicados.
      </p>
    ) : (
      <ul class="mt-10 space-y-px" role="list">
        {sortedPosts.map((post) => {
          const formattedDate = post.data.date.toLocaleDateString("es-ES", {
            year: "numeric",
            month: "short",
            day: "numeric",
          });

          return (
            <li role="listitem">
              <a
                href={`/blog/${post.data.slug}/`}
                class="group flex items-start justify-between gap-6 rounded-lg border border-transparent px-4 py-4 -mx-4 transition-all duration-300 hover:border-zinc-600 hover:bg-zinc-800/60"
              >
                <div class="min-w-0">
                  <p class="text-md font-medium text-zinc-100 group-hover:text-white transition-colors">
                    {post.data.title}
                  </p>
                  <p class="mt-1 text-xs text-zinc-300 leading-relaxed line-clamp-2">
                    {post.data.description}
                  </p>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {post.data.tags?.map((tag) => (
                      <span class="rounded border border-zinc-700 px-2 py-0.5 text-xs text-zinc-300 uppercase">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
                <span class="shrink-0 font-mono text-xs text-zinc-300 group-hover:text-zinc-500 transition-colors pt-0.5">
                  {formattedDate}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    )}

  </section>
</BaseLayout>