---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Blog - bernalac"
  description="Artículos sobre desarrollo web, Java, Spring Boot, arquitectura de software y experiencias aprendidas durante mi carrera como desarrollador full stack."
>
  <section class="mx-auto w-full max-w-2xl px-4 py-16">

    <h1 class="text-4xl font-medium leading-tight text-zinc-100">
      Artículos
    </h1>

    {sortedPosts.length > 0 && (
        <p class="mt-3 text-zinc-300 leading-relaxed">
          {sortedPosts.length}{" "}
          {sortedPosts.length === 1 ? "entrada" : "entradas"} ·
          {" "}Java, Spring Boot, arquitectura y desarrollo web.
        </p>
      )}

    {sortedPosts.length === 0 ? (
      <p class="mt-10 text-zinc-300">
        Todavía no hay artículos publicados.
      </p>
    ) : (
      <ul class="mt-12 space-y-4" role="list">
        {sortedPosts.map((post) => {
          const formattedDate = post.data.date.toLocaleDateString("es-ES", {
            year: "numeric",
            month: "short",
            day: "numeric",
          });

          return (
            <li role="listitem">
              <a
                href={`/blog/${post.data.slug}/`}
                class="group block rounded-xl border border-transparent px-5 py-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-zinc-700 hover:bg-zinc-800/60"
              >
                <!-- Top row (title + date) -->
                <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                  <h2 class="text-lg font-semibold text-zinc-100 transition-colors group-hover:text-cyan-300">
                    {post.data.title}
                  </h2>

                  <div class="flex items-center gap-2 text-xs text-zinc-400 sm:pt-1 shrink-0">
                    <span>{formattedDate}</span>
                    <span class="opacity-0 translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0">
                      →
                    </span>
                  </div>
                </div>

                <!-- Description -->
                <p class="mt-3 text-sm text-zinc-300 leading-relaxed line-clamp-3 sm:line-clamp-2">
                  {post.data.description}
                </p>

                <!-- Tags -->
                {post.data.tags?.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span  class="rounded-full bg-zinc-800 px-2.5 py-1 text-xs text-zinc-300 uppercase">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    )}

  </section>
</BaseLayout>