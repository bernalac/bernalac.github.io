---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { GetStaticPaths } from "astro";
import Paginator from "../../components/blog/Paginator.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection(
    "blog",
    ({ data }) => !data.draft
  );

  const sortedPosts = posts.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );

  return paginate(sortedPosts, {
    pageSize: 3,
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const sortedPosts = page.data;
---

<BaseLayout
  title="Artículos - bernalac"
  description="Explora mis artículos sobre desarrollo web, Java, Spring Boot y arquitectura de software. Comparte experiencias, aprendizajes y decisiones técnicas."
>
  <section>
    <header>
      <p
        class="text-sm font-medium uppercase tracking-[0.18em] text-accent"
      >
        Artículos
      </p>

      <h1
        class="mt-5 text-4xl font-semibold tracking-[-0.035em] text-primary sm:text-5xl"
      >
        Notas de desarrollo
      </h1>

      <p
        class="mt-5 max-w-xl text-base leading-7 text-content-muted sm:text-lg"
      >
        Problemas, soluciones y aprendizajes sobre desarrollo web, Java, Spring Boot y arquitectura de software.
      </p>
    </header>

    {
      sortedPosts.length === 0 ? (
        <div class="mt-12 border-y border-border py-10">
          <p class="text-base text-content-muted">
            Todavía no hay artículos publicados.
          </p>
        </div>
      ) : (
        <ul
          class="mt-12 flex flex-col gap-8"
          role="list"
        >
          {sortedPosts.map((post) => {
            const formattedDate = post.data.date.toLocaleDateString(
              "es-ES",
              {
                year: "numeric",
                month: "short",
                day: "numeric",
              }
            );

            return (
              <li role="listitem">
                <a
                  href={`/blog/${post.id}/`}
                  class="group relative block rounded-lg border border-border/80 bg-surface-elevated/50 px-5 py-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/40 sm:px-6 sm:py-6"
                >
                  <!-- Título + fecha -->
                  <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-5">
                    <h2
                      class="text-xl font-semibold tracking-[-0.02em] text-content transition-colors duration-200 group-hover:text-accent"
                    >
                      {post.data.title}
                    </h2>

                    <time
                      datetime={post.data.date.toISOString()}
                      class="shrink-0 text-sm text-content-muted"
                    >
                      {formattedDate}
                    </time>
                  </div>

                  <!-- Descripción -->
                  <p
                    class="mt-3 text-base leading-7 text-content-muted line-clamp-2"
                  >
                    {post.data.description}
                  </p>

                  <!-- Tags -->
                  {
                    post.data.tags?.length > 0 && (
                      <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1">
                        {post.data.tags.map((tag) => (
                          <span
                            class="text-xs font-medium text-content-muted transition-colors duration-200 group-hover:text-accent"
                          >
                            #{tag}
                          </span>
                        ))}
                      </div>
                    )
                  }

                  <!-- Indicador -->
                  <span
                    aria-hidden="true"
                    class="absolute bottom-5 right-5 text-lg text-accent opacity-0 transition-all duration-200 group-hover:translate-x-1 group-hover:opacity-100"
                  >
                    →
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }

    <!-- Paginación -->
    <div class="mt-12">
      <Paginator page={page} />
    </div>
  </section>
</BaseLayout>