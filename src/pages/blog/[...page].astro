---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { GetStaticPaths } from "astro";
import Paginator from "../../components/blog/Paginator.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return paginate(sortedPosts, { pageSize: 3 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const sortedPosts = page.data;
---

<BaseLayout
  title="Blog - bernalac"
  description="Artículos sobre desarrollo web, Java, Spring Boot, arquitectura de software y experiencias aprendidas durante mi carrera como desarrollador full stack."
>
  <section class="mx-auto w-full max-w-2xl px-4 py-12 sm:py-16">

    <h1 class="text-3xl font-medium leading-tight text-zinc-100 sm:text-4xl">
      Artículos
    </h1>

    <p class="mt-2 text-sm text-zinc-300 sm:text-base">
      Escribo sobre desarrollo web, Java, Spring Boot, arquitectura de software y experiencias aprendidas durante mi carrera.
    </p>

    {sortedPosts.length === 0 ? (
      <div class="mt-12 rounded-xl border border-dashed border-zinc-700 px-5 py-10 text-center">
        <p class="text-zinc-400">
          Todavía no hay artículos publicados.
        </p>
      </div>
    ) : (
      <ul class="mt-10 space-y-3 sm:mt-12 sm:space-y-4" role="list">
        {sortedPosts.map((post) => {
          const formattedDate = post.data.date.toLocaleDateString("es-ES", {
            year: "numeric",
            month: "short",
            day: "numeric",
          });

          return (
            <li role="listitem">
              <a
                href={`/blog/${post.id}/`}
                class="group relative block overflow-hidden rounded-xl border border-zinc-800/80 bg-zinc-900/30 px-4 py-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-cyan-700/50 hover:bg-zinc-800/60 hover:shadow-lg hover:shadow-cyan-950/20 sm:px-5 sm:py-5"
              >
                <!-- Accent bar on hover -->
                <span class="absolute inset-y-0 left-0 w-0.5 scale-y-0 bg-cyan-400 transition-transform duration-300 group-hover:scale-y-100"></span>

                <!-- Top row (title + date) -->
                <div class="flex flex-col gap-1.5 sm:flex-row sm:items-start sm:justify-between sm:gap-2">
                  <h2 class="text-base font-semibold text-zinc-100 transition-colors group-hover:text-cyan-300 sm:text-lg">
                    {post.data.title}
                  </h2>

                  <div class="flex shrink-0 items-center gap-2 text-xs text-zinc-500 sm:pt-1">
                    <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
                    <span class="hidden translate-x-1 opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100 sm:inline">
                      →
                    </span>
                  </div>
                </div>

                <!-- Description -->
                <p class="mt-2 text-sm leading-relaxed text-zinc-400 line-clamp-2 sm:mt-3">
                  {post.data.description}
                </p>

                <!-- Tags -->
                {post.data.tags?.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5 sm:mt-4 sm:gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="rounded-full bg-zinc-800 px-2 py-0.5 text-[10px] text-zinc-400 uppercase tracking-wide group-hover:bg-zinc-700/80 sm:px-2.5 sm:py-1 sm:text-xs">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    )}

    <Paginator page={page} />

  </section>
</BaseLayout>