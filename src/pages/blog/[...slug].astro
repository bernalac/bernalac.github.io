---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: {
      slug: post.id,
    },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const { Content } = await render(post);

const { title, description, date, tags, cover, robots } = post.data;

const formattedDate = date.toLocaleDateString("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={`${title} - bernalac`}
  description={description}
  noindex={!robots}
  image={cover?.src}
>
  <article
    id="top"
    class="scroll-mt-32 md:scroll-mt-24"
  >
    <!-- PORTADA -->
    {
      cover && (
        <Image
          src={cover}
          alt={`Portada del artículo: ${title}`}
          class="mb-12 h-auto w-full rounded-lg border border-border object-cover"
          loading="eager"
          fetchpriority="high"
        />
      )
    }

    <!-- CABECERA -->
    <header class="mb-12">
      {
        tags && tags.length > 0 && (
          <div class="mb-5 flex flex-wrap gap-x-3 gap-y-1.5">
            {tags.map((tag) => (
              <span class="text-xs font-medium text-accent">#{tag}</span>
            ))}
          </div>
        )
      }

      <h1
        class="text-4xl font-semibold leading-tight tracking-[-0.035em] text-primary sm:text-5xl"
      >
        {title}
      </h1>

      <div class="mt-5 flex items-center gap-3 text-sm text-content-muted">
        <time datetime={date.toISOString()}>
          {formattedDate}
        </time>

        <span aria-hidden="true">·</span>

        <span>bernalac</span>
      </div>

      <p class="mt-6 text-lg leading-8 text-content-muted">
        {description}
      </p>
    </header>

    <!-- CONTENIDO -->
    <div
      class="prose
    prose-lg
    max-w-none
    prose-headings:font-semibold
    prose-headings:tracking-[-0.02em]
    prose-headings:text-primary
    prose-h2:mt-14
    prose-h2:mb-5
    prose-h2:text-2xl
    prose-h2:scroll-mt-32
    md:prose-h2:scroll-mt-24
    prose-h3:mt-10
    prose-h3:mb-4
    prose-h3:text-xl
    prose-h3:scroll-mt-32
    md:prose-h3:scroll-mt-24
    prose-p:leading-8
    prose-p:text-content
    prose-a:font-medium
    prose-a:text-accent
    prose-a:no-underline
    [&_a:hover]:underline
    prose-strong:font-semibold
    prose-strong:text-primary
    /* Código inline */
    prose-code:rounded
    prose-code:bg-burgundy-950/8
    prose-code:px-1.5
    prose-code:py-0.5
    prose-code:text-[0.9em]
    prose-code:font-medium
    prose-code:text-accent
    prose-code:before:content-none
    prose-code:after:content-none
    /* Bloques de código */
    prose-pre:my-8
    prose-pre:overflow-x-auto
    prose-pre:rounded-xl
    prose-pre:border
  prose-pre:border-burgundy-900/40
  prose-pre:bg-burgundy-950
    prose-pre:px-0
    prose-pre:py-0
    prose-pre:text-sm
    prose-pre:leading-7
    prose-pre:[&>code]:block
    prose-pre:[&>code]:px-5
    prose-pre:[&>code]:py-5
    /* Listas */
    prose-ul:my-6
    prose-ul:pl-6
    prose-ol:my-6
    prose-ol:pl-6
    prose-li:my-2
    prose-li:pl-2
    prose-li:leading-8
    prose-li:text-content
    prose-li:marker:text-accent
    /* Citas */
    prose-blockquote:border-l-2
    prose-blockquote:border-accent
    prose-blockquote:bg-burgundy-950/5
    prose-blockquote:px-5
    prose-blockquote:py-2
    prose-blockquote:text-content-muted
    /* Tablas */
    prose-table:text-base
    prose-thead:border-border
    prose-th:text-content
    prose-tbody:divide-border
    prose-td:text-content-muted
    /* Separadores */
    prose-hr:border-border
    /* Imágenes */
    prose-img:rounded-lg
    prose-img:border
    prose-img:border-border"
    >
      <Content />
    </div>

    <!-- FOOTER DEL ARTÍCULO -->
    <footer
      class="mt-16 flex items-center justify-between border-t border-border pt-6"
    >
      <a
        href="/blog/"
        class="group inline-flex items-center gap-2 text-base font-medium text-content-muted transition-colors duration-200 hover:text-accent"
      >
        <span
          aria-hidden="true"
          class="transition-transform duration-200 group-hover:-translate-x-1"
        >
          ←
        </span>

        Volver al blog
      </a>

      <a
        href="#top"
        class="group inline-flex items-center gap-2 text-base font-medium text-content-muted transition-colors duration-200 hover:text-accent"
      >
        Volver arriba

        <span
          aria-hidden="true"
          class="transition-transform duration-200 group-hover:-translate-y-1"
        >
          ↑
        </span>
      </a>
    </footer>
  </article>
</BaseLayout>
