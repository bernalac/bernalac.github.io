---
import Button from "../components/ui/generics/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 - Página no encontrada"
  description="La página que estás buscando no existe. Puede que haya sido eliminada, cambiada de nombre o ya no esté disponible."
>
  <section>
    <div>
      <p
        class="text-sm font-medium uppercase tracking-[0.2em] text-accent"
      >
        Error 404
      </p>

      <h1
        class="mt-5 max-w-xl text-4xl font-semibold tracking-[-0.03em] text-primary sm:text-5xl"
      >
        Página no encontrada.
      </h1>

      <p
        class="mt-5 max-w-lg text-base leading-7 text-content-muted sm:text-lg"
      >
        Quizá era una idea que nunca llegó a producción.
      </p>

      <div class="mt-8">
        <Button href="/">
          Volver al inicio
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
