---
import Button from "../components/ui/generics/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 - Página no encontrada">
  <section class="mx-auto w-full max-w-2xl px-4 py-16">

    <p class="font-mono text-xs text-zinc-300 tracking-widest uppercase mb-6">
      404
    </p>

    <h1 class="text-3xl font-medium text-zinc-100 leading-tight">
      Página no encontrada.
    </h1>

    <p class="mt-3 text-zinc-300 leading-relaxed">
      Quizá era una idea que nunca llegó a producción.
    </p>

    <div class="mt-8">
      <Button href="/">
        Volver al inicio
      </Button>
    </div>

  </section>
</BaseLayout>